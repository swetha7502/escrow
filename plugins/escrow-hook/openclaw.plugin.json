{
  "id": "escrow-hook",
  "name": "Escrow Hook",
  "description": "Escrow safety layer: holds every side effect in escrow until the session is verified.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "stateDir": {
        "type": "string"
      },
      "inferenceUrl": {
        "type": "string"
      }
    }
  },
  "contracts": {
    "tools": [
      "escrow_send_email",
      "escrow_write_external",
      "escrow_status",
      "escrow_commit",
      "escrow_abort"
    ]
  },
  "toolMetadata": {
    "escrow_send_email": {
      "optional": false
    },
    "escrow_write_external": {
      "optional": false
    },
    "escrow_status": {
      "optional": false
    },
    "escrow_commit": {
      "optional": false
    },
    "escrow_abort": {
      "optional": false
    }
  }
}
