# Where the UI finds the Escrow control API (harness/server.ts). Empty = same origin (the dev/preview proxy).
VITE_API_BASE=
# WebSocket event stream. Empty = derived from VITE_API_BASE (or same origin) + /events.
VITE_WS_URL=
# Dev/preview proxy target (not shipped to the browser)
ESCROW_BACKEND=http://127.0.0.1:8790
